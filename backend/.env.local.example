# ===================================================================
# 🔐 BACKEND ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy file này thành backend/.env và điền các giá trị thật
# File .env sẽ KHÔNG được commit vào git
# ===================================================================

# --- App Configuration ---
PORT=4000
NODE_ENV=development

# --- Frontend URL (for CORS and password reset links) ---
APP_URL="http://localhost:3000"
# CORS_ORIGINS:
#   'https://a.com,https://b' -> chỉ các domain này (khuyến nghị)
#   'https://*.vercel.app'    -> wildcard subdomain
#   '*'                       -> PUBLIC API, mọi website gọi được (tránh dùng)
CORS_ORIGINS="http://localhost:3000"

# --- Database ---
# Development: Sử dụng Supabase free tier hoặc local PostgreSQL
# Production: Supabase, Neon, hoặc Railway PostgreSQL
# ⚠️ Lưu ý với Supabase: Direct connection (db.xxx.supabase.co) chỉ hỗ trợ IPv6.
# Hãy dùng Connection Pooler (Session mode - port 5432) để hỗ trợ IPv4:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- JWT Authentication ---
# Generate mới: node scripts/generate-secrets.js
# Hoặc: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-128-character-hex-secret-here"
JWT_EXPIRES_IN="15m"

REFRESH_TOKEN_SECRET="your-128-character-hex-secret-here"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Password reset link TTL (minutes)
PASSWORD_RESET_TTL_MINUTES=60

# --- PDF / Chromium (tuỳ chọn) ---
# Đóng Chromium sau khi rảnh N ms để trả lại ~180-200MB RAM (mặc định 60000)
PDF_BROWSER_IDLE_TIMEOUT_MS=60000
# Timeout render 1 hóa đơn (mặc định 30000)
PDF_RENDER_TIMEOUT_MS=30000
# Host ngoài được phép tải khi render PDF (mặc định: qr.sepay.vn + host backend).
# Thêm domain logo/ảnh nếu cần, cách nhau bởi dấu phẩy.
PDF_ALLOWED_HOSTS=""

# --- Proxy / rate limiting ---
# Số hop reverse proxy tin cậy (Render = 1). Chạy trực tiếp không qua proxy: false.
TRUST_PROXY=false

# --- Bảo mật đăng nhập / webhook ---
# Để trống => confirm-payment trả 503 (fail closed)
PAYMENT_WEBHOOK_SECRET=""
# Đăng ký công khai mặc định tắt
ALLOW_PUBLIC_REGISTER=false
# Chỉ dùng khi database CHƯA có user nào (mật khẩu >= 12 ký tự)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Email Configuration (SMTP) ---
# Sử dụng Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="your-email@gmail.com"

# --- Cloudflare R2 / S3 Storage (Optional) ---
# Để trống nếu chưa dùng
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="invoice-air-storage"
R2_PUBLIC_URL=""
