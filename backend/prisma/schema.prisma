datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum InvoiceStatus {
  ISSUED
  SENT
  PAID
  CANCELLED
}

// Loại hoá đơn theo quy định Việt Nam (Nghị định 123/2020/NĐ-CP)
enum InvoiceType {
  GTGT // Hoá đơn giá trị gia tăng
  BAN_HANG // Hoá đơn bán hàng
  TAI_SAN_CONG // Hoá đơn điện tử bán tài sản công
  DU_TRU_QG // Hoá đơn điện tử bán hàng dự trữ quốc gia
}

// Hình thức hoá đơn điện tử
enum InvoiceForm {
  WITH_TAX_CODE // Có mã của cơ quan thuế
  WITHOUT_TAX_CODE // Không có mã của cơ quan thuế
  POS_CONNECTED // Từ máy tính tiền có kết nối dữ liệu với cơ quan thuế
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String?
  role                 Role      @default(ADMIN)
  hashedRefreshToken   String?
  resetPasswordToken   String? // SHA-256 hash của token đặt lại mật khẩu (gửi qua email)
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Setting {
  id          String  @id @default("default")
  companyName String  @default("CÔNG TY TNHH GIÁO DỤC AI ROBOTIC")
  taxCode     String? @default("3603893101")
  address     String? @default("Số 10 Huỳnh Văn Nghệ, P. Trấn Biên, Đồng Nai")
  phone       String? @default("0900000000")
  email       String? @default("contact@airobotics.edu.vn")
  logoUrl     String?
  companies   String? // JSON string: CompanyProfile[] danh sách nhiều đơn vị cung cấp

  // Thông tin ngân hàng & QR
  bankCode        String? @default("Vietcombank")
  bankAccount     String? @default("SHYNNERI")
  bankAccountName String? @default("AI ROBOTIC")
  bankAccounts    String? // JSON string: BankAccount[] danh sách nhiều tài khoản ngân hàng
  qrTemplate      String? @default("compact") // compact, qr_only, etc.

  // Quy tắc hóa đơn
  invoicePrefix       String @default("HD")
  invoiceNumberLength Int    @default(6)
  nextInvoiceNumber   Int    @default(1)
  defaultCurrency     String @default("VND")
  defaultVatRate      Float  @default(10)

  // Mẫu nội dung email thông báo & hóa đơn
  emailAlertSubject   String?
  emailAlertBody      String?
  invoiceEmailSubject String?
  invoiceEmailBody    String?

  // Cấu hình Kênh thông báo (Email & Zalo Bot Gateway)
  enableEmailNotification Boolean @default(true)
  enableZaloNotification  Boolean @default(false)
  zaloApiBaseUrl          String? @default("https://sms-service.talab.io.vn/api/gateway/v1.0")
  zaloBotId               String?
  zaloApiKey              String?
  zaloAutoFriendRequest   Boolean @default(false)
  zaloAliasPrefix         String? @default("KH_")
  zaloMessageTemplate     String?

  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  invoiceType   InvoiceType   @default(GTGT)
  invoiceForm   InvoiceForm   @default(WITH_TAX_CODE)
  paymentCode   String? // Mã 6 ký tự đối soát (VD: A8X9K2)
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  currency      String        @default("VND")
  templateId    String        @default("standard-classic")
  notes         String?
  terms         String?

  // Thông tin đơn vị cung cấp (Người bán - Snapshot tại thời điểm lập HĐ)
  sellerName    String?
  sellerTaxCode String?
  sellerAddress String?
  sellerPhone   String?
  sellerEmail   String?
  sellerLogoUrl String?

  // Thông tin người mua
  buyerName    String
  buyerCompany String?
  buyerTaxCode String?
  buyerAddress String?
  buyerEmail   String?
  buyerPhone   String?

  // Tài chính
  hasVat     Boolean @default(true)
  vatRate    Float   @default(10)
  subTotal   Float   @default(0)
  vatAmount  Float   @default(0)
  otherFee   Float   @default(0)
  grandTotal Float   @default(0)

  // QR Code & Storage Link
  qrDataUrl  String? // Base64 QR hoặc VietQR link
  pdfUrl     String? // Link lưu trữ trên Cloudflare R2
  shareToken String? @unique // Token chia sẻ trực tuyến

  items     InvoiceItem[]
  histories InvoiceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  name        String
  description String?
  metaInfo    String? // VD: (01/01/2026 - 31/01/2026)
  unit        String  @default("dịch vụ")
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  discount    Float   @default(0)
  taxRate     Float   @default(0)
  taxAmount   Float   @default(0)
  amount      Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceHistory {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action    String // CREATED, UPDATED, ISSUED, SENT, CANCELLED
  note      String?
  actor     String?
  createdAt DateTime @default(now())
}

model ServiceCatalog {
  id          String        @id @default(uuid())
  name        String
  description String?
  metaInfo    String? // VD: 1 Năm, 25/06/2026 - 25/06/2027
  unit        String        @default("gói")
  unitPrice   Float         @default(0)
  groupId     String?
  group       ServiceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ServiceGroup {
  id          String           @id @default(uuid())
  name        String           // Tên nhóm (VD: "AI Writer (Web 1)", "AI Tools Khóa Học")
  code        String?          // Mã định danh ngắn (VD: "ai-writer", "edu-landing")
  website     String?          // Website quản lý / domain (VD: "https://aiwriter.ntcore.io.vn")
  description String?
  color       String?          @default("#2563eb") // Màu nhận diện thẻ nhóm
  sortOrder   Int              @default(0)
  services    ServiceCatalog[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum MessageChannel {
  ZALO
  EMAIL
}

enum MessageTriggerType {
  INVOICE_CREATED
  PAYMENT_SUCCESS
  SUBSCRIPTION_ALERT
  CUSTOM
}

model MessageTemplate {
  id          String             @id @default(uuid())
  name        String             // Tên gợi nhớ mẫu tin nhắn
  channel     MessageChannel     @default(ZALO)
  triggerType MessageTriggerType @default(INVOICE_CREATED)
  subject     String?            // Tiêu đề (với Email)
  content     String             // Nội dung tin nhắn / HTML
  serviceIds  String?            // JSON string array các ID gói dịch vụ áp dụng: string[]
  attachments String?            // JSON string: Array<{ id?: string, name: string, url: string, size?: number, type?: string }>
  isDefault   Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([channel, triggerType])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

model CustomerSubscription {
  id              String  @id @default(uuid())
  customerName    String
  customerEmail   String
  customerPhone   String?
  customerCompany String?

  serviceId    String?
  serviceName  String
  servicePrice Float   @default(0)
  cycle        String? @default("1 năm")

  startDate DateTime @default(now())
  endDate   DateTime

  status SubscriptionStatus @default(ACTIVE)

  staffName  String?
  staffEmail String?

  notes           String?
  lastAlertSentAt DateTime?
  alertCount      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String    // Tên mô tả (VD: "Landing Page Khóa Học", "N8N Automation", "CRM Vtiger")
  keyHash     String    @unique // SHA-256 hash của API key để kiểm tra an toàn
  prefix      String    // Tiền tố hiển thị: "air_live_7a8b..."
  lastChars   String    // 4 ký tự cuối: "...9f2a"
  permissions String    @default("all") // "all" | "invoices:create" | "invoices:read"
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QueueType {
  QUICK_CREATE_INVOICE
  PAYMENT_CONFIRMATION
  DELIVERY_EMAIL
  DELIVERY_ZALO
  WEBHOOK_EVENT
  CUSTOM
}

model RequestQueue {
  id           String      @id @default(uuid())
  type         QueueType   @default(QUICK_CREATE_INVOICE)
  status       QueueStatus @default(PENDING)
  priority     Int         @default(0) // Số càng cao mức độ ưu tiên càng lớn
  apiName      String?     @default("Hệ thống") // Tên API / API Key (VD: "AI WRITER", "Landing Page Tuyển Sinh")
  endpoint     String?     // Endpoint tiếp nhận (VD: "/api/invoices/quick-create")
  source       String?     // Nguồn gọi (VD: "API Key", "Web Landing", "Admin Dashboard")
  title        String?     // Tiêu đề ngắn gọn mô tả request (VD: "Gửi Email hóa đơn #HD-000001")
  targetInfo   String?     // Thông tin người nhận (VD: "nguyenvana@gmail.com - 0901234567")
  payload      Json        // Dữ liệu payload của request (body, headers, params)
  result       Json?       // Kết quả xử lý (nếu thành công)
  errorMessage String?     // Ghi nhận lỗi nếu thất bại
  retryCount   Int         @default(0)
  maxRetries   Int         @default(5)
  nextRunAt    DateTime    @default(now()) // Thời điểm chạy tiếp theo (hỗ trợ thử lại sau vài phút)
  processedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, nextRunAt])
  @@index([type, status])
  @@index([apiName])
  @@index([createdAt])
}


