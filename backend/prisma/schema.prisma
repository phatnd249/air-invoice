datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum InvoiceStatus {
  ISSUED
  SENT
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id                  String   @id @default("default")
  companyName         String   @default("CÔNG TY TNHH GIÁO DỤC AI ROBOTIC")
  taxCode             String?  @default("3603893101")
  address             String?  @default("Số 10 Huỳnh Văn Nghệ, P. Trấn Biên, Đồng Nai")
  phone               String?  @default("0900000000")
  email               String?  @default("contact@airobotics.edu.vn")
  logoUrl             String?
  
  // Thông tin ngân hàng & QR
  bankCode            String?  @default("Vietcombank")
  bankAccount         String?  @default("SHYNNERI")
  bankAccountName     String?  @default("AI ROBOTIC")
  qrTemplate          String?  @default("compact") // compact, qr_only, etc.

  // Quy tắc hóa đơn
  invoicePrefix       String   @default("HD")
  invoiceNumberLength Int      @default(6)
  nextInvoiceNumber   Int      @default(1)
  defaultCurrency     String   @default("VND")
  defaultVatRate      Float    @default(10)

  updatedAt           DateTime @updatedAt
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  paymentCode     String?       // Mã 6 ký tự đối soát (VD: A8X9K2)
  status          InvoiceStatus @default(ISSUED)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  currency        String        @default("VND")
  templateId      String        @default("standard-classic")
  notes           String?
  terms           String?

  // Thông tin người mua
  buyerName       String
  buyerCompany    String?
  buyerTaxCode    String?
  buyerAddress    String?
  buyerEmail      String?
  buyerPhone      String?

  // Tài chính
  hasVat          Boolean       @default(true)
  vatRate         Float         @default(10)
  subTotal        Float         @default(0)
  vatAmount       Float         @default(0)
  otherFee        Float         @default(0)
  grandTotal      Float         @default(0)

  // QR Code & Storage Link
  qrDataUrl       String?       // Base64 QR hoặc VietQR link
  pdfUrl          String?       // Link lưu trữ trên Cloudflare R2
  shareToken      String?       @unique // Token chia sẻ trực tuyến

  items           InvoiceItem[]
  histories       InvoiceHistory[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int      @default(0)
  name        String
  description String?
  metaInfo    String?  // VD: (01/01/2026 - 31/01/2026)
  unit        String   @default("dịch vụ")
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  amount      Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InvoiceHistory {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action    String   // CREATED, UPDATED, ISSUED, SENT, CANCELLED
  note      String?
  actor     String?
  createdAt DateTime @default(now())
}

model ServiceCatalog {
  id          String   @id @default(uuid())
  name        String
  description String?
  metaInfo    String?  // VD: 1 Năm, 25/06/2026 - 25/06/2027
  unit        String   @default("gói")
  unitPrice   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
