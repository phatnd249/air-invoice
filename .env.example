# Monorepo Environment Configuration

# App Ports
PORT=4000
FRONTEND_PORT=3000

# Database (SQLite / libSQL)
DATABASE_URL="file:./dev.db"

# JWT Auth
JWT_SECRET="super-secret-jwt-key-invoice-air"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-invoice-air"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Cloudflare R2 / S3 Storage (Files, Logo, Invoices PDF)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="invoice-air-storage"
R2_PUBLIC_URL=""

# Email (SMTP / Resend)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@invoice-air.com"
