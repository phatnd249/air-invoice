# ===================================================================
# 🔐 ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# ⚠️  ĐỂ SETUP THỰC TẾ:
#     Backend:  Xem backend/.env.local.example
#     Frontend: Xem frontend/.env.local.example
# ===================================================================
# File này CHỈ là template để tham khảo structure
# Các file .env thật sẽ KHÔNG được commit vào git
# ===================================================================

# --- App Ports ---
PORT=4000
FRONTEND_PORT=3000

# --- Frontend URL ---
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Database (Supabase / PostgreSQL) ---
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# --- JWT Auth ---
# ⚠️  Generate mới: node scripts/generate-secrets.js
# ⚠️  PHẢI là 128 ký tự hex ngẫu nhiên
JWT_SECRET="generate-new-secret-with-script"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="generate-new-secret-with-script"
REFRESH_TOKEN_EXPIRES_IN="7d"
PASSWORD_RESET_TTL_MINUTES=60

# --- Email (SMTP) ---
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# --- Cloudflare R2 / S3 Storage (Optional) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="invoice-air-storage"
R2_PUBLIC_URL=""
