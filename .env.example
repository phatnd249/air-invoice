# ===================================================================
# 🔐 ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# ⚠️  ĐỂ SETUP THỰC TẾ:
#     Backend:  Xem backend/.env.local.example
#     Frontend: Xem frontend/.env.local.example
# ===================================================================
# File này CHỈ là template để tham khảo structure
# Các file .env thật sẽ KHÔNG được commit vào git
# ===================================================================

# --- App Ports ---
PORT=4000
FRONTEND_PORT=3000

# --- Frontend URL ---
APP_URL="http://localhost:3000"
# 🔒 Khuyến nghị: chỉ liệt kê domain chính thức, cách nhau bởi dấu phẩy.
# Chỉ dùng '*' khi thật sự muốn mở API cho mọi website.
CORS_ORIGINS="http://localhost:3000"

# --- Database (Supabase / PostgreSQL) ---
# ⚠️ Lưu ý: Direct connection (db.xxx.supabase.co) chỉ hỗ trợ IPv6.
# Hãy dùng Connection Pooler (Session mode - port 5432) để tương thích IPv4:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- JWT Auth ---
# ⚠️  Generate mới: node scripts/generate-secrets.js
# ⚠️  PHẢI là 128 ký tự hex ngẫu nhiên
JWT_SECRET="generate-new-secret-with-script"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="generate-new-secret-with-script"
REFRESH_TOKEN_EXPIRES_IN="7d"
PASSWORD_RESET_TTL_MINUTES=60

# 🔒 Secret cho webhook thanh toán (header x-webhook-secret). Để trống => endpoint trả 503.
PAYMENT_WEBHOOK_SECRET="generate-new-secret-with-script"
# 🔒 Đăng ký công khai (mặc định tắt)
ALLOW_PUBLIC_REGISTER=false
# 🔒 Chỉ dùng khi database chưa có user nào
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Proxy / PDF ---
# Số hop proxy tin cậy để lấy IP thật (Render = 1). Đặt false khi chạy trực tiếp.
TRUST_PROXY=1
# Host ngoài được phép tải khi render PDF (mặc định có qr.sepay.vn + host backend)
PDF_ALLOWED_HOSTS=""

# --- Email (SMTP) ---
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# --- Cloudflare R2 / S3 Storage (Optional) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="invoice-air-storage"
R2_PUBLIC_URL=""
