# Monorepo Environment Configuration

# App Ports
PORT=4000
FRONTEND_PORT=3000

# Public URL of the Frontend (used to build the password-reset link fallback)
# NOTE: Backend auto-derives the frontend URL from the Origin header at runtime,
# so this is only a fallback when Origin is unavailable.
APP_URL="http://localhost:3000"

# CORS allowed origins (comma-separated) — set to your production domain(s) when deploying
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (SQLite / libSQL)
DATABASE_URL="file:./dev.db"

# JWT Auth
JWT_SECRET="super-secret-jwt-key-invoice-air"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-invoice-air"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Password reset link validity (minutes)
PASSWORD_RESET_TTL_MINUTES=60

# Cloudflare R2 / S3 Storage (Files, Logo, Invoices PDF)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="invoice-air-storage"
R2_PUBLIC_URL=""

# Email (SMTP / Resend)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@invoice-air.com"
