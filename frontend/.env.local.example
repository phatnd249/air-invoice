# ===================================================================
# 🌐 FRONTEND ENVIRONMENT CONFIGURATION (Next.js)
# ===================================================================
# Copy file này thành frontend/.env.local và điền URL backend production
# ===================================================================

# --- Backend API URL ---
# Development: http://localhost:4000/api
# Production: URL Railway backend của bạn (VD: https://your-app.up.railway.app/api)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- Notes ---
# - NEXT_PUBLIC_* biến được expose ra client-side code
# - Không đặt secrets vào NEXT_PUBLIC_* variables
# - Vercel sẽ tự động inject environment variables từ dashboard
